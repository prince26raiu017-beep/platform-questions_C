#include <stdio.h>

int main() {
    int num;
    long long factorial = 1;

    // Read input from STDIN
    if (scanf("%d", &num) == 1) {
        for (int i = 1; i <= num; i++) {
            factorial *= i;
        }
        // Print only the result to STDOUT
        printf("%lld\n", factorial);
    }

    return 0;
}
